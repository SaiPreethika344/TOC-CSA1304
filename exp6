#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, j, valid = 1;

    printf("Enter string: ");
    scanf("%s", s);

    j = strlen(s) - 1;

    while (s[i] == '0')
        i++;

    while (j >= 0 && s[j] == '1')
        j--;

    if (i != j + 1)
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
