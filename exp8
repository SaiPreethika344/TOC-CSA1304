#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 1, n;

    printf("Enter string: ");
    scanf("%s", s);

    n = strlen(s);

    if (s[0] != 'b' || s[n-1] != 'a')
        valid = 0;

    for (i = 0; i < n; i++) {
        if (s[i] != 'a' && s[i] != 'b')
            valid = 0;
    }

    if (valid)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
