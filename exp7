#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 1;

    printf("Enter string: ");
    scanf("%s", s);

    if (strstr(s, "101") == NULL)
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}
